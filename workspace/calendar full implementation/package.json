{
  "name": "calendly-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "frontend": "npm --prefix medical-dashboard run dev -- --host 0.0.0.0 --port 5173",
    "server": "cross-env NODE_ENV=development PORT=3001 nodemon backend/server.js",
    "build": "npm --prefix medical-dashboard run build && node backend/copyFrontend.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "vite": "^5.3.3",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.19"
  }
}
